# Copiez ce fichier en ".env" (usage LOCAL uniquement : XAMPP, php -S...) puis renseignez vos identifiants.
# Le fichier ".env" ne doit JAMAIS être publié publiquement ni envoyé sur Vercel.
#
# SUR VERCEL : ne créez pas de fichier .env. Saisissez ces mêmes variables dans
# Vercel > Project > Settings > Environment Variables (voir DEPLOIEMENT_VERCEL.md).
# Là-bas, écrivez les valeurs SANS guillemets (ex. SMTP_FROM_NAME = Dahira Ndiapandal ...).

# ── Base de données MySQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=diapandale
DB_USER=root
DB_PASSWORD=

# Optionnels (bases MySQL hébergées, obligatoires sur Vercel pour la plupart d'entre elles)
# DB_PORT=3306
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_VERIFY=true

# ── Envoi d'emails (code OTP, récupération de mot de passe) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM_NAME="Dahira Ndiapandal Bou Serigne Saliou Mbacke"
SMTP_FROM_EMAIL=noreply@votre-domaine.com
